{
  "name": "reporter-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "harness:setup": "node scripts/setup-git-hooks.mjs",
    "harness:branch": "node scripts/validate-branch-name.mjs",
    "harness:commit": "node scripts/validate-commit-message.mjs",
    "harness:size": "node scripts/check-change-size.mjs",
    "harness:design": "node scripts/check-design-system.mjs",
    "harness:content": "node scripts/check-content-density.mjs",
    "harness:version": "node scripts/check-versioning.mjs",
    "gate:commit": "pnpm harness:size && pnpm harness:design && pnpm harness:content",
    "gate:quick": "pnpm harness:design && pnpm harness:content && pnpm harness:version && pnpm lint && pnpm typecheck && pnpm test",
    "gate": "pnpm gate:quick && pnpm build",
    "check": "pnpm gate",
    "release:prepare": "node scripts/prepare-release.mjs",
    "prepare": "pnpm harness:setup"
  },
  "dependencies": {
    "@content-ventures/design-system": "github:content-ventures/design-system#main",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.33.0"
}

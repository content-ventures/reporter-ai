{
  "name": "reporter-ai",
  "version": "0.17.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-next.mjs",
    "start": "next start",
    "dev:local": "node scripts/dev-local.mjs",
    "start:local": "REPORTER_DEPLOYMENT_MODE=local REPORTER_LOCAL_MODE=true REPORTER_ALLOW_LOCAL_BUILD=true next start --hostname 127.0.0.1 --port 3002",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"scripts/**/*.test.mjs\" \"src/**/*.test.ts\"",
    "smoke": "playwright test e2e/connected-smoke.spec.ts e2e/material-progress.spec.ts e2e/new-production-editor.spec.ts e2e/local-profiles.spec.ts e2e/account.spec.ts e2e/overview-layout.spec.ts e2e/pipeline-management.spec.ts e2e/hard-news-demo.spec.ts",
    "smoke:fixtures": "playwright test e2e/article.spec.ts e2e/library.spec.ts e2e/main-path.spec.ts e2e/routes.spec.ts",
    "harness:setup": "node scripts/setup-git-hooks.mjs",
    "harness:branch": "node scripts/validate-branch-name.mjs",
    "harness:commit": "node scripts/validate-commit-message.mjs",
    "harness:identity": "node scripts/validate-git-identity.mjs",
    "harness:size": "node scripts/check-change-size.mjs",
    "harness:design": "node scripts/check-design-system.mjs",
    "harness:architecture": "node scripts/check-architecture.mjs",
    "harness:content": "node scripts/check-content-density.mjs",
    "harness:version": "node scripts/check-versioning.mjs",
    "gate:commit": "pnpm harness:identity && pnpm harness:size && pnpm harness:design && pnpm harness:architecture && pnpm harness:content",
    "gate:quick": "pnpm harness:design && pnpm harness:architecture && pnpm harness:content && pnpm harness:version && pnpm lint && pnpm typecheck && pnpm test",
    "gate": "pnpm gate:quick && pnpm build",
    "check": "pnpm gate",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:prepare:auto": "node scripts/prepare-release.mjs --auto",
    "prepare": "pnpm harness:setup",
    "worker": "node --conditions=react-server --import tsx src/server/worker.ts",
    "worker:local": "REPORTER_DEPLOYMENT_MODE=local REPORTER_LOCAL_MODE=true pnpm worker",
    "test:backend": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:rehearsal": "node --conditions=react-server --import tsx --test \"tests/rehearsal/*.test.ts\"",
    "db:up": "node scripts/reporter-db.mjs up",
    "db:stop": "node scripts/reporter-db.mjs stop",
    "db:status": "node scripts/reporter-db.mjs status",
    "db:flow": "node scripts/reporter-db.mjs flow",
    "db:test": "node scripts/reporter-db.mjs test",
    "db:cloud:status": "node scripts/reporter-cloud.mjs status",
    "db:cloud:migrate": "node scripts/reporter-cloud.mjs migrate",
    "db:cloud:roles": "node scripts/reporter-cloud.mjs roles",
    "db:cloud:grant": "node scripts/reporter-cloud.mjs grant",
    "db:cloud:smoke": "node scripts/reporter-cloud-smoke.mjs",
    "cloud:check": "node scripts/check-app-health.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@content-ventures/design-system": "https://github.com/content-ventures/design-system/archive/0479b31c567653c76b93ec2ec89eb6976ce31172.tar.gz",
    "@neon/functions": "^0.11.0",
    "@neondatabase/auth": "0.6.0-beta",
    "@next/env": "16.3.8",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@vercel/functions": "^3.9.11",
    "busboy": "1.6.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "youtube-caption-extractor": "1.10.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@neon/config": "^1.9.1",
    "@neon/config-runtime": "1.9.1",
    "@playwright/test": "1.62.1",
    "@types/busboy": "1.5.5",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0"
}

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Primary free commercial photo provider. Server-only; full API access is needed for originals.
PIXABAY_API_KEY=
# Optional legacy providers, not offered for new searches. Preserve old image provenance.
UNSPLASH_ACCESS_KEY=
# New Pexels key issuance is currently paused. Commons needs no key.
PEXELS_API_KEY=
# Existing OPEN_AI_API_KEY and CLAUDE_API_KEY names are also accepted server-side.
REPORTER_LOCAL_MODE=true
# Optional absolute public URL for canonical links, sharing metadata and the sitemap.
# On Vercel, the project's stable production domain is used automatically when unset.
# REPORTER_APP_URL=https://your-production-domain.example
# Cloud/Vercel uses explicit mode and separate least-privilege database logins.
# Local mode always reads Docker passwords from .env.reporter-db; the cloud values below are never
# tried against 127.0.0.1:55432.
# REPORTER_DEPLOYMENT_MODE=cloud
# REPORTER_DATABASE_URL=
# REPORTER_WORKER_DATABASE_URL=
# On Vercel, prefer the two passwords below: the app derives a branch-correct URL
# from the integration-managed DATABASE_URL without ever using its owner login.
# REPORTER_RUNTIME_PASSWORD=
# REPORTER_WORKER_PASSWORD=
# REPORTER_DEFAULT_PORTAL_ID=10000000-0000-0000-0000-000000000101
# NEON_AUTH_BASE_URL=
# NEON_AUTH_COOKIE_SECRET=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_GENERATION_MODEL=openai/gpt-oss-120b
# Optional default for a fresh workspace; existing per-step settings stay authoritative.
# REPORTER_GENERATION_MODEL=openai/gpt-4.1
